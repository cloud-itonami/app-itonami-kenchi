;; kenchi-clj — provenance-gated, multi-source real-estate valuation library.
;; Coordinate: io.github.kotoba-lang/kenchi  · public API: kenchi.core
{:paths ["src"]
 ;; langgraph-clj brings langchain-clj transitively (both zero-/single-dep,
 ;; all .cljc → portable to JVM / SCI / ClojureScript / GraalVM). The pure core
 ;; (kenchi.core/fusion/governor) needs neither; langgraph-clj is for the
 ;; optional actor (kenchi.parcel). Same runtime the robotaxi-actor sits on.
 :deps {
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.io"}
        ;; kotoba.http.form-urlencoded replaced java.net.URLEncoder/URLDecoder here
        ;; (2026-09-24). An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/http-parse-url
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.http"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.json replaced clojure.data.json here (2026-09-24). An explicit
        ;; floor: kotoba.json/read-str and /write-str first exist at 9c11ad1, and
        ;; tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/json
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.json"}
       ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/langgraph
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.langgraph"}}
 :aliases
 {;; offline workspace dev — pin transitive langchain-clj to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain {:local/root "../langchain"}}}
  ;; kbb -M:dev:run  → value one parcel through three scenarios (mock feeds)
  :run {:main-opts ["-m" "kenchi.sim"]}
  ;; kbb -M:dev:live → full live-wiring pipeline offline: real adapters
  ;; (fixtures) → fuse/govern → PDS putRecord (dry-run) → flywheel recalibration.
  ;; `valuation` on the classpath so ingest fixtures resolve via io/resource.
  :live {:extra-paths ["valuation"]
         :main-opts ["-m" "kenchi.live"]}
  ;; kbb -M:live-real ["POSTCODE"] → REAL network call to HM Land Registry
  ;; via kenchi.http (java.net.http + data.json) through the live ingest adapter.
  :live-real {:extra-deps {org.clojure/data.json {:mvn/version "2.5.0"}}
              :main-opts ["-m" "kenchi.live-real"]}
  ;; kbb -M:cc-real ["URL-PATTERN" LIMIT] → REAL Common Crawl pull of
  ;; property asking prices (CC index → WARC range-fetch → price extract).
  :cc-real {:extra-deps {org.clojure/data.json {:mvn/version "2.5.0"}}
            :main-opts ["-m" "kenchi.cc-real"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}